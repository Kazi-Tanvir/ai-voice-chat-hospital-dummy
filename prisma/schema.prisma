generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model appointment {
  id          String   @id
  doctorId    String
  patientName String
  day         String
  timeSlot    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  doctor      doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade, map: "Appointment_doctorId_fkey")

  @@index([doctorId], map: "Appointment_doctorId_fkey")
}

model doctor {
  id                 String        @id
  name               String
  field              String
  medicalStudy       String
  researchBackground String
  email              String?       @unique(map: "Doctor_email_key")
  phone              String?
  experienceYears    Int?
  bio                String?
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime
  appointment        appointment[]
  schedule           schedule[]
}

model schedule {
  id        String   @id
  doctorId  String
  day       String
  timeSlots String
  createdAt DateTime @default(now())
  updatedAt DateTime
  doctor    doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade, map: "Schedule_doctorId_fkey")

  @@index([doctorId], map: "Schedule_doctorId_fkey")
}
