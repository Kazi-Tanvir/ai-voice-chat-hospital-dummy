// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Doctor {
  id                 String     @id @default(cuid())
  name               String
  field              String     // e.g., Cardiology, Pediatrics
  medicalStudy       String     // e.g., MD from Harvard Medical School
  researchBackground String     // e.g., Research on cardiovascular disease
  email              String?    @unique
  phone              String?
  experienceYears    Int?
  bio                String?
  isActive           Boolean    @default(true)
  schedules          Schedule[]
  appointments       Appointment[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model Schedule {
  id        String   @id @default(cuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  day       String   // e.g., "Saturday", "Sunday", "Wednesday"
  timeSlots String   // e.g., "8:30 AM - 11:20 AM, 6:00 PM - 9:00 PM"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Appointment {
  id          String   @id @default(cuid())
  doctorId    String
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientName String
  day         String
  timeSlot    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
